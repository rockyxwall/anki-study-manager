{
  "name": "anki-study-manager",
  "version": "1.0.0",
  "description": "Personal Anki study manager, taxonomy, and curriculum workflows",
  "type": "module",
  "scripts": {
    "migrate-math:dry": "node tools/migrate-deck.mjs --subject math --dry-run",
    "migrate-math:exec": "node tools/migrate-deck.mjs --subject math --execute",
    "migrate-math:restore": "node tools/migrate-deck.mjs --subject math --restore",
    "migrate-ict:dry": "node tools/migrate-deck.mjs --subject ict --dry-run",
    "migrate-ict:exec": "node tools/migrate-deck.mjs --subject ict --execute",
    "migrate-ict:restore": "node tools/migrate-deck.mjs --subject ict --restore",
    "migrate-bangla:dry": "node tools/migrate-deck.mjs --subject bangla --dry-run",
    "migrate-bangla:exec": "node tools/migrate-deck.mjs --subject bangla --execute",
    "migrate-bangla:restore": "node tools/migrate-deck.mjs --subject bangla --restore",
    "migrate-english:dry": "node tools/migrate-deck.mjs --subject english --dry-run",
    "migrate-english:exec": "node tools/migrate-deck.mjs --subject english --execute",
    "migrate-english:restore": "node tools/migrate-deck.mjs --subject english --restore",
    "migrate-physics:dry": "node tools/migrate-deck.mjs --subject physics --dry-run",
    "migrate-physics:exec": "node tools/migrate-deck.mjs --subject physics --execute",
    "migrate-physics:restore": "node tools/migrate-deck.mjs --subject physics --restore",
    "migrate-chem:dry": "node tools/migrate-deck.mjs --subject chem --dry-run",
    "migrate-chem:exec": "node tools/migrate-deck.mjs --subject chem --execute",
    "migrate-chem:restore": "node tools/migrate-deck.mjs --subject chem --restore",
    "migrate-lang:dry": "node tools/migrate-deck.mjs --subject lang --dry-run",
    "migrate-lang:exec": "node tools/migrate-deck.mjs --subject lang --execute",
    "migrate-lang:restore": "node tools/migrate-deck.mjs --subject lang --restore",
    "audio:word": "node tools/populate-word-audio.mjs",
    "clean-tags:dry": "node tools/clean-tags.mjs --dry-run",
    "clean-tags:exec": "node tools/clean-tags.mjs --execute",
    "organize-types": "node tools/organize-card-types.mjs",
    "reorganize-presets": "node tools/reorganize-deck-presets.mjs",
    "describe-io": "node tools/describe-io-cards.mjs",
    "describe-io:dry": "node tools/describe-io-cards.mjs --dry-run",
    "template:spelling": "node tools/update-spelling-template.mjs",
    "import-kotlin": "node tools/import-kotlin-course.mjs",
    "audit:math": "node tools/audit-deck.mjs --audit-math"
  },
  "keywords": ["anki", "study", "hsc", "flashcards"],
  "license": "MIT"
}

      "Header": {
        "value": "বিপ্রতিসম ম্যাট্রিক্স (Skew Symmetric Matrix)",
        "order": 2
      },
      "Back Extra": {
        "value": "",
        "order": 3
      },
      "Comments": {
        "value": "Skew symmetric matrix definition: Square matrix where $A^T = -A$. Key properties: (1) Main diagonal elements are always zero ($a_{ij} = 0$ for $i=j$). (2) Off-diagonal elements satisfy $a_{ij} = -a_{ji}$ for $i \\neq j$. Example provided: $A = \\begin{bmatrix} 0 & -2 & -3 \\\\ 2 & 0 & 4 \\\\ 3 & -4 & 0 \\end{bmatrix}$. Testable: diagonal must be zero, transpose equals negative matrix.",
        "order": 4
      }
    },

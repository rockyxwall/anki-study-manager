        "value": "{{c1::image-occlusion:rect:left=.1273:top=.0638:width=.302:height=.0794:oi=1}}<br>{{c1::image-occlusion:rect:left=.6731:top=.4071:width=.2449:height=.0993:oi=1}}<br>",
